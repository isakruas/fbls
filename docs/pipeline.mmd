flowchart TB
  classDef gpu fill:#e6eef5,stroke:#7a93ab,color:#1f2429
  classDef gate fill:#fff,stroke:#b4521a,stroke-width:2px,color:#1f2429
  classDef io fill:#fff,stroke:#1f2429,color:#1f2429

  IN["Input: NPZ sector files<br/>time_bjd, flux, flux_err, optional centroid"]:::io
  PREP["Common preparation<br/>per-sector median normalization, 10-min weighted bins,<br/>errors inflated to adjacent-difference scatter"]:::gpu
  IN --> PREP

  subgraph FAM["Duration families: window w = clamp(3·D, 0.4 d, 3.5 d); equal windows share a family"]
    direction LR
    FA["Family A, w = 0.4 d<br/>durations 0.5–3.0 h<br/>biweight detrend, edge trim w/2, positive clip, rho_D"]:::gpu
    FB["Family B, w = 0.47 d<br/>duration 3.7 h"]:::gpu
    FK["… Family K, w = 3.47 d<br/>duration 27.8 h"]:::gpu
  end
  PREP -->|"relative flux, sigma"| FAM

  subgraph PASS["Pass k (k = 1..3), every family, unmasked observations"]
    GRID["Period grid per family<br/>0.5 d → min(100 d, baseline B)<br/>log step: B·ΔP/P ≤ D_min/3; bands of factor 2; D &lt; P/4"]:::gpu
    FOLD["Fold per period (Triton)<br/>4 fields per phase bin, interleaved;<br/>doubled cumulative sums → wrap-free interval sums"]:::gpu
    SCAN["Fused scan (tile_choice)<br/>box at every bin × duration;<br/>trapezoids only where box ≥ 0.6·threshold;<br/>float32 ranking, exact float64 winner"]:::gpu
    TABLE["Pass table: best template per period<br/>(period, epoch, duration, SNR, depth, family)"]:::io
    SELECT["Peak selection (greedy by SNR)<br/>1. isolated rescoring without accepted-peak points ≥ threshold·√(unshared fraction)<br/>2. &lt; 50% in-transit points shared with accepted peaks<br/>3. ≥ 2 sampled epochs with ≥ 3 points<br/>4. statistic without strongest event ≥ 0.5·threshold"]:::gate
    GRID --> FOLD --> SCAN -->|"SNR ≥ threshold"| TABLE --> SELECT
  end
  FAM -->|"residual, sigma, rho_D, noise model"| GRID
  SELECT -.->|"mask 1.5·D of accepted peaks; stop when no new peak"| GRID

  EVID["Planet / binary / noise evidence<br/>strongest 32 peaks, other peaks masked;<br/>secondary at 0.25/0.5/0.75, odd–even at 2P,<br/>V shapes, depth scales; cone bounds"]:::gpu
  SINGLE["Single-event scan<br/>one trial period &gt; B (no folding);<br/>templates ≥ threshold not coinciding with accepted peaks"]:::gpu
  SELECT -->|"accepted peaks, all passes"| EVID
  SELECT -->|"masks"| SINGLE

  OUT["Output, schema 3<br/>candidates: model-preferred first, by planet/noise evidence<br/>signal_candidates: by isolated SNR<br/>single_events; table (first-pass maxima, 14 columns); statistics"]:::io
  EVID --> OUT
  SINGLE --> OUT
